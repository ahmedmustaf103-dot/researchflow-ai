generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResearchStatus {
  queued
  planning
  researching
  verifying
  analysing
  reporting
  completed
  failed
  cancelled
}

enum TaskStatus {
  pending
  running
  completed
  failed
}

enum MessageRole {
  user
  assistant
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  projects      ResearchProject[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model ResearchProject {
  id           String         @id @default(cuid())
  userId       String
  title        String
  question     String         @db.Text
  status       ResearchStatus @default(queued)
  errorMessage String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks    ResearchTask[]
  sources  Source[]
  findings Finding[]
  reports  Report[]
  messages Message[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

model ResearchTask {
  id         String     @id @default(cuid())
  projectId  String
  title      String
  query      String     @db.Text
  status     TaskStatus @default(pending)
  sortOrder  Int
  resultJson Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sources Source[]

  @@index([projectId, sortOrder])
}

model Source {
  id          String    @id @default(cuid())
  projectId   String
  taskId      String?
  url         String
  title       String
  snippet     String?   @db.Text
  content     String?   @db.Text
  contentHash String?
  httpStatus  Int?
  toolName    String?
  fetchedAt   DateTime?
  createdAt   DateTime  @default(now())

  project  ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task     ResearchTask?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  findings Finding[]

  @@unique([projectId, url])
  @@index([projectId])
  @@index([taskId])
  @@index([contentHash])
}

model Finding {
  id         String   @id @default(cuid())
  projectId  String
  sourceId   String
  subject    String
  attribute  String
  value      String   @db.Text
  quote      String   @db.Text
  confidence Float
  createdAt  DateTime @default(now())

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source  Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sourceId])
}

model Report {
  id          String   @id @default(cuid())
  projectId   String
  markdown    String   @db.Text
  outlineJson Json
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId])
}

model Message {
  id           String      @id @default(cuid())
  projectId    String
  role         MessageRole
  content      String      @db.Text
  citationJson Json?
  createdAt    DateTime    @default(now())

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
